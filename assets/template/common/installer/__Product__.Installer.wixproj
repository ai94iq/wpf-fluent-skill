<Project Sdk="WixToolset.Sdk/__V:WixToolset.Sdk@6__">
  <PropertyGroup>
    <OutputName>__Product__-Setup-$(Version)</OutputName>
    <InstallerPlatform>x64</InstallerPlatform>
    <Cultures>ar-SA</Cultures>
    <PublishDir>$(MSBuildThisFileDirectory)..\artifacts\publish\win-x64</PublishDir>
    <DefineConstants>Version=$(Version);PublishDir=$(PublishDir)</DefineConstants>
    <!-- WiX packages are versioned here, not through CPM; keep both on the same 6.x version -->
    <ManagePackageVersionsCentrally>false</ManagePackageVersionsCentrally>
    <!-- WinAppSDK ships localized .mui files whose language IDs ICE03 rejects; suppress it for those packages only -->
    <SuppressIces Condition="Exists('$(PublishDir)\Microsoft.ui.xaml.dll')">ICE03</SuppressIces>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="WixToolset.UI.wixext" Version="__V:WixToolset.UI.wixext@6__" />
  </ItemGroup>
</Project>
