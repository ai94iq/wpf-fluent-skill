<Wix xmlns="http://wixtoolset.org/schemas/v4/wxs"
     xmlns:ui="http://wixtoolset.org/schemas/v4/wxs/ui">

  <!-- UpgradeCode is fixed forever. Never change it. -->
  <Package Name="!(loc.ProductName)"
           Manufacturer="!(loc.Manufacturer)"
           Version="$(var.Version)"
           Language="1025"
           UpgradeCode="__UpgradeCode__"
           Scope="perMachine">

    <!-- AllowSameVersionUpgrades lets a test build install over the same version; ICE61 is expected. -->
    <MajorUpgrade AllowSameVersionUpgrades="yes" DowngradeErrorMessage="!(loc.DowngradeError)" />
    <MediaTemplate EmbedCab="yes" CompressionLevel="high" />

    <!-- The icon Id must match the exe file name for the advertised shortcut (ICE50). -->
    <Icon Id="__Product__.exe" SourceFile="..\src\__Product__.App\Assets\app.ico" />
    <Property Id="ARPPRODUCTICON" Value="__Product__.exe" />
    <WixVariable Id="WixUILicenseRtf" Value="License.rtf" />

    <StandardDirectory Id="ProgramFiles64Folder">
      <Directory Id="INSTALLFOLDER" Name="__Product__" />
    </StandardDirectory>

    <Feature Id="Main">
      <ComponentGroupRef Id="AppFiles" />
    </Feature>

    <ui:WixUI Id="WixUI_InstallDir" InstallDirectory="INSTALLFOLDER" />
  </Package>

  <Fragment>
    <ComponentGroup Id="AppFiles" Directory="INSTALLFOLDER">
      <!-- Everything from the publish folder except the exe, which needs a known Id for the shortcut -->
      <Files Include="$(var.PublishDir)\**">
        <Exclude Files="$(var.PublishDir)\__Product__.exe" />
      </Files>
      <Component Id="AppExe">
        <File Id="AppExeFile" Source="$(var.PublishDir)\__Product__.exe" KeyPath="yes" />
        <!-- Advertised shortcut in the exe's own component: per-machine safe and ICE-clean. -->
        <Shortcut Id="AppShortcut"
                  Advertise="yes"
                  Directory="ProgramMenuFolder"
                  Name="!(loc.ProductName)"
                  Icon="__Product__.exe" />
      </Component>
    </ComponentGroup>

    <StandardDirectory Id="ProgramMenuFolder" />
  </Fragment>
</Wix>
